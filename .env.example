# Copy this file to .env.local and fill in real values before running `npm run seed`.

# Login credentials for the admin dashboard (only used the first time you run `npm run seed`).
ADMIN_EMAIL=dewa@gmail.com
ADMIN_PASSWORD=admin1

# Random long string used to sign the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-64-char-string
