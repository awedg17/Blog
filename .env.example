# Copy this file to .env.local before running the app.
# Admin accounts are NOT configured here — run `npm run create-admin` after
# `npm install` to create your first login.

# Random long string used to sign the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-64-char-string
